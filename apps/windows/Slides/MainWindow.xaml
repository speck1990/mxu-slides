<Window x:Class="Slides.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Slides"
        Title="Slides" Width="1480" Height="900" MinWidth="1050" MinHeight="650"
        Background="#1C1C1E" Foreground="#F2F2F4" FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#242426" />
    <SolidColorBrush x:Key="Line" Color="#3A3A3D" />
    <SolidColorBrush x:Key="Muted" Color="#A4A4A8" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#343438" />
      <Setter Property="Foreground" Value="#F2F2F4" />
      <Setter Property="BorderBrush" Value="#48484D" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#333337" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#48484D" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#F2F2F4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style x:Key="SidebarItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="5,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#505053" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SlideItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,14,18" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="TileBorder" BorderThickness="3" BorderBrush="Transparent" CornerRadius="8" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#32C55C" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TileBorder" Property="Background" Value="#343438" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="292" MinWidth="240" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="345" MinWidth="290" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Background="{StaticResource Panel}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="8" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <StackPanel DockPanel.Dock="Top" Margin="14,14,14,10">
          <TextBlock Text="Service Flow" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Text="Service date" Margin="0,8,0,3" Foreground="{StaticResource Muted}" FontSize="11" />
          <DatePicker x:Name="ServiceDatePicker" SelectedDateChanged="OnServiceDateChanged" />
          <TextBlock x:Name="ServiceSummary" Margin="0,7,0,0" Foreground="{StaticResource Muted}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,8,12">
          <WrapPanel>
            <Button Content="+ Add Item" Click="AddLibrarySelection" />
            <Button Content="New Song" Click="AddSong" />
            <Button Content="New Deck" Click="AddDeck" />
          </WrapPanel>
          <WrapPanel Margin="0,7,0,0">
            <Button Content="↑" ToolTip="Move earlier" Click="MoveServiceUp" />
            <Button Content="↓" ToolTip="Move later" Click="MoveServiceDown" />
            <Button Content="Remove" Click="RemovePresentation" />
            <Button Content="Duplicate" Click="DuplicateServiceItem" ToolTip="Repeat this item with a separate live timer" />
            <Button Content="Plan Item" Click="PlanServiceItem" />
          </WrapPanel>
        </StackPanel>
        <ListBox x:Name="Presentations" ItemContainerStyle="{StaticResource SidebarItem}"
                 SelectionChanged="OnPresentationChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding SectionHeader}" Visibility="{Binding HeaderVisibility}"
                           Foreground="#32C55C" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,5" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Visibility="{Binding SubtitleVisibility}"
                           Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="#38383B" />
      <DockPanel Grid.Row="2">
        <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
          <TextBlock Text="Libraries" FontWeight="SemiBold" FontSize="16" />
          <ComboBox x:Name="LibraryTypeFilter" Margin="0,8,0,0" SelectionChanged="OnLibraryTypeChanged"
                    ToolTip="Show songs, slide decks, or media decks">
            <ComboBoxItem Content="All Items" />
            <ComboBoxItem Content="Songs" />
            <ComboBoxItem Content="Slide Decks" />
            <ComboBoxItem Content="Media Decks" />
          </ComboBox>
          <ComboBox x:Name="FolderFilter" Margin="0,8,0,0" DisplayMemberPath="Name"
                    SelectionChanged="OnFolderFilterChanged" ToolTip="Browse all items, top level, or a folder" />
          <TextBox x:Name="LibrarySearch" Margin="0,8,0,0" ToolTip="Search the song and slide library" TextChanged="OnLibrarySearchChanged" />
          <WrapPanel Margin="0,8,0,0">
            <Button Content="New Folder" Click="NewFolder" />
            <Button x:Name="RenameFolderButton" Content="Rename" Click="RenameFolder" IsEnabled="False" />
            <Button x:Name="DeleteFolderButton" Content="Delete" Click="DeleteFolder" IsEnabled="False" />
          </WrapPanel>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="12,8,8,12">
          <Button Content="+ New" Click="AddSong" />
          <Button Content="New Deck" Click="AddDeck" />
          <Button Content="Add Media" Click="AddMedia" />
          <Button Content="Import MxU" Click="ImportMxu" />
          <Button x:Name="VisualPowerPointButton" Content="Import PPTX" Click="ImportPowerPoint" ToolTip="Render every slide with installed Microsoft PowerPoint for faithful colors and layouts" />
          <Button Content="PPTX Editable" Click="ImportPowerPointEditable" ToolTip="Import supported text, shapes, and images as editable objects; some colors and effects may differ" />
          <Button Content="Edit" Click="EditLibraryItem" />
          <Button Content="Arrangements" Click="EditLibraryArrangements" ToolTip="Build song section orders for services" />
          <Button Content="Duplicate" Click="DuplicateLibraryItem" />
          <Button Content="Delete" Click="DeleteLibraryItem" />
          <Button Content="Move To" Click="MoveLibraryItem" />
          <Button Content="Relink Media" Click="RelinkMedia" />
        </WrapPanel>
        <ListBox x:Name="LibraryList" ItemContainerStyle="{StaticResource SidebarItem}"
                 DisplayMemberPath="Name" MouseDoubleClick="OnLibraryDoubleClick" />
      </DockPanel>
    </Grid>
    <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="82" Margin="16,0">
          <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="SelectionTitle" Text="Select an item in Service Flow" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Edit Song" Click="EditSong" />
            <Button Content="Edit Slides" Click="EditSlides" />
            <Button Content="Arrangements" Click="EditArrangements" ToolTip="Repeat or reorder song sections" />
            <Button Content="New Show" Click="NewShow" />
            <Button Content="Open Show" Click="OpenShow" />
            <Button Content="Save As" Click="SaveShowAs" />
            <Button Content="Pack Show" Click="PackShow" ToolTip="Save a portable show with its media" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}" />
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,9">
          <StackPanel>
            <TextBlock x:Name="VideoName" Text="No video playing" Foreground="{StaticResource Muted}" FontSize="11" />
            <Grid Margin="0,5,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="VideoButton" Content="Pause" Click="ToggleVideo" IsEnabled="False" />
              <Slider x:Name="VideoSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False"
                      VerticalAlignment="Center" Margin="5,0,10,0" ValueChanged="SeekVideo" />
              <TextBlock x:Name="VideoTime" Grid.Column="2" Text="00:00 / 00:00" Foreground="{StaticResource Muted}"
                         FontFamily="Consolas" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
        <ListBox x:Name="Slides" Margin="15,16,0,0" ItemContainerStyle="{StaticResource SlideItem}"
                 SelectionChanged="OnSlideChanged" MouseDoubleClick="FireSelectedSlide"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="218">
                <Border Width="215" Height="121" Background="#111218" CornerRadius="5" ClipToBounds="True">
                  <Viewbox Stretch="Uniform">
                    <local:SlideSurface Width="960" Height="540" CurrentSlide="{Binding Slide}" IsThumbnail="True" />
                  </Viewbox>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="3,7,0,0">
                  <TextBlock Text="{Binding Number}" Foreground="#32C55C" FontWeight="SemiBold" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Name}" Foreground="#D1D1D4" TextTrimming="CharacterEllipsis" Width="180" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="2" Background="{StaticResource Panel}">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="14,14,14,8">
        <TextBlock DockPanel.Dock="Top" Text="Output Preview" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
        <Border Background="Black" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" VerticalAlignment="Top">
          <Viewbox Stretch="Uniform"><local:SlideSurface x:Name="Preview" Width="960" Height="540" /></Viewbox>
        </Border>
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="14,8,14,14">
        <TextBlock DockPanel.Dock="Top" Text="Service Controls" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="AUDIENCE DISPLAY" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,5" />
          <ComboBox x:Name="DisplaySelector" Background="#343438" Foreground="White" Margin="0,0,0,10" />
          <Button x:Name="ProjectButton" Content="Start Projection  (F5)" Click="ToggleProjection" Margin="0,0,0,8" />
          <TextBlock Text="STAGE DISPLAY" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,5" />
          <ComboBox x:Name="StageDisplaySelector" Background="#343438" Foreground="White" Margin="0,0,0,7" />
          <Button x:Name="StageButton" Content="Open Stage Display" Click="ToggleStage" Margin="0,0,0,10" />
          <WrapPanel>
            <Button Content="← Previous" Click="Previous" />
            <Button Content="Next →" Click="Next" />
          </WrapPanel>
          <WrapPanel Margin="0,7,0,0">
            <Button Content="← Previous Item" Click="PreviousItem" />
            <Button Content="Next Item →" Click="NextItem" />
          </WrapPanel>
          <Button x:Name="BlackButton" Content="Black Screen  (B)" Click="ToggleBlack" Margin="0,8,0,0" />
          <WrapPanel Margin="0,7,0,0">
            <Button Content="Clear Slides" Click="ClearSlides" />
            <Button Content="Clear All" Click="ClearAll" />
          </WrapPanel>
          <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" Margin="0,14,0,0" />
          <TextBlock Text="LIVE SERVICE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,7" />
          <WrapPanel>
            <Button x:Name="RunButton" Content="Start Run" Click="ToggleRun" />
            <Button Content="Reset Run" Click="ResetRun" />
          </WrapPanel>
          <TextBlock x:Name="RunStatus" Margin="0,10,0,0" />
          <TextBlock x:Name="ItemRunStatus" Margin="0,5,0,0" />
          <TextBlock x:Name="RemainingStatus" Margin="0,5,0,0" Foreground="#32C55C" />
          <TextBlock x:Name="OperatorNote" Margin="0,12,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="COUNTDOWN TIMER" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,7" />
          <WrapPanel>
            <TextBox x:Name="CountdownMinutes" Text="5" Width="48" ToolTip="Minutes, from 1 to 480" />
            <Button Content="Set" Click="SetCountdown" Margin="6,0,0,0" />
            <Button x:Name="CountdownButton" Content="Start" Click="ToggleCountdown" />
            <Button Content="Reset" Click="ResetCountdown" />
          </WrapPanel>
          <TextBlock x:Name="CountdownStatus" Margin="0,8,0,0" FontFamily="Consolas" FontSize="16" />
          <TextBlock Text="OVERLAYS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,7" />
          <ListBox x:Name="OverlaysList" Height="110" ItemContainerStyle="{StaticResource SidebarItem}"
                   DisplayMemberPath="Name" MouseDoubleClick="OnOverlayDoubleClick" />
          <WrapPanel Margin="0,7,0,0">
            <Button Content="New" Click="NewOverlay" />
            <Button Content="Edit" Click="EditOverlay" />
            <Button Content="Fire" Click="FireOverlay" />
            <Button Content="Clear Overlay" Click="ClearOverlay" />
          </WrapPanel>
          <Button Content="Delete Selected Overlay" Click="DeleteOverlay" Margin="0,6,0,0" />
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
